---
/*
 * Unlisted family history. Nothing on the site links here, there is no
 * sitemap, and the page asks crawlers not to index or follow it. It is
 * deliberately absent from robots.txt, which anyone can read.
 *
 * The records are encrypted (src/data/family.enc.json). This page is only
 * the frame: it asks for the family passphrase, and everything else, down
 * to the intro and the source credit, is filled in after the records open.
 */
import Layout from '../layouts/Layout.astro';
import Rail from '../components/Rail.astro';
---

<Layout title="Family lines" description="Hemnes family records." noindex>
  <Rail plain />

  <main id="main" class="fam">
    <header class="shell fam__head">
      <p class="tag fam__eyebrow">Unlisted · Not in the directory</p>
      <h1 class="fam__title">Family lines</h1>
      <p class="fam__lede" data-intro hidden></p>
      <ul class="fam__stats" data-stats hidden></ul>
    </header>

    <div class="shell">
      <form class="fam__lock" data-lock hidden>
        <p class="fam__lock-lede">These records are for family. Enter the passphrase you were given to open them.</p>
        <input type="text" name="username" value="Hemnes family" autocomplete="username" hidden />
        <label class="tag" for="fam-pass">Passphrase</label>
        <div class="fam__lock-row">
          <input
            id="fam-pass"
            name="password"
            type="password"
            autocomplete="current-password"
            autocapitalize="none"
            autocorrect="off"
            spellcheck="false"
            aria-describedby="fam-lock-error"
          />
          <button class="btn" type="submit">Open</button>
        </div>
        <label class="fam__lock-keep">
          <input id="fam-remember" type="checkbox" checked />
          Remember on this device
        </label>
        <p class="fam__lock-error" id="fam-lock-error" data-lock-error role="alert"></p>
      </form>
      <noscript><p class="fam__lock-lede">This page needs JavaScript to open the family records.</p></noscript>
    </div>

    <div data-app hidden>
      <div class="fam__bar">
        <div class="shell fam__bar-inner">
          <nav class="fam__tabs" aria-label="Views">
            <a href="#/explore" data-tab="explore">Explore</a>
            <a href="#/ancestors" data-tab="ancestors">Ancestors</a>
            <a href="#/lines" data-tab="lines">Lines</a>
            <a href="#/map" data-tab="map">Map</a>
          </nav>
          <div class="fam__search" role="search">
            <label class="vh" for="fam-q">Find a person or place</label>
            <input
              id="fam-q"
              type="search"
              role="combobox"
              aria-expanded="false"
              aria-controls="fam-q-list"
              aria-autocomplete="list"
              autocomplete="off"
              spellcheck="false"
              placeholder="Find a name or place  /"
            />
            <ul id="fam-q-list" class="fam__results" role="listbox" aria-label="Matches" hidden></ul>
          </div>
        </div>
      </div>

      <div class="shell">
        <div class="fam__who">
          <div class="fam__who-ask" data-who-ask>
            <label class="tag" for="fam-who-q">Who are you?</label>
            <div class="fam__search fam__search--who">
              <input
                id="fam-who-q"
                type="search"
                role="combobox"
                aria-expanded="false"
                aria-controls="fam-who-list"
                aria-autocomplete="list"
                aria-describedby="fam-who-hint"
                autocomplete="off"
                spellcheck="false"
                placeholder="Type your name"
              />
              <ul id="fam-who-list" class="fam__results" role="listbox" aria-label="People" hidden></ul>
            </div>
            <p class="fam__who-hint" id="fam-who-hint">
              Optional. Pick yourself and every record shows how that person is related to you. It’s remembered in this
              browser only.
            </p>
          </div>
          <p class="fam__who-set" data-who-set hidden aria-live="polite">
            Viewing as <a data-who-name href="#/explore"></a>
            <button type="button" class="linkish" data-who-change>Not you?</button>
          </p>
        </div>
        <div id="fam-view" class="fam__view"></div>
      </div>

      <footer class="shell fam__source">
        <h2 class="tag">Source</h2>
        <p><cite data-source-title></cite>. <span data-source-credit></span></p>
        <p>
          Dates and spellings follow the source. Where its pages disagree, or a date looks like a typo, the person’s
          notes say so.
        </p>
        <p>
          <button type="button" class="btn" data-forget>Lock on this device</button>
        </p>
      </footer>
    </div>
  </main>
</Layout>

<script>
  import { unlock } from '../lib/family-lock';

  unlock(document.querySelector<HTMLElement>('.fam')!);
</script>

<style is:global>
  /* Global because the views are drawn by script; every rule is scoped under .fam. */

  .fam {
    padding-bottom: 5rem;
    /* Dark native controls: scrollbars, the search field's clear button. */
    color-scheme: dark;
  }

  .fam [hidden] {
    display: none !important;
  }

  .fam .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .fam .muted {
    color: var(--muted);
  }

  .fam ul,
  .fam ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fam h3 {
    font-weight: 400;
  }

  /* ── Header ──────────────────────────────────────────────────────────── */

  .fam__head {
    display: grid;
    gap: 1rem;
    padding-block: clamp(3rem, 7vw, 5rem) clamp(2rem, 4vw, 3rem);
  }

  .fam__title {
    font-size: var(--step-3);
    font-variation-settings: 'wdth' 112;
    font-weight: 750;
  }

  .fam__lede {
    font-size: var(--step-1);
    color: var(--second);
    max-width: 46ch;
  }

  .fam__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 0.5rem !important;
  }

  .fam__stats li {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .fam__stat {
    font-family: var(--data);
    font-size: var(--step-1);
    color: var(--bone);
  }

  /* ── Lock ────────────────────────────────────────────────────────────── */

  .fam__lock {
    display: grid;
    /* minmax lets the passphrase field shrink below its natural width on small phones. */
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    max-width: 30rem;
    padding-bottom: 4rem;
  }

  .fam__lock-lede {
    font-size: var(--step-1);
    color: var(--second);
    max-width: 40ch;
    margin-bottom: 0.5rem;
  }

  .fam__lock-row {
    display: flex;
    gap: 0.5rem;
  }

  .fam__lock-row input {
    flex: 1;
    min-width: 0;
    padding: 0.6rem 0.75rem;
    background: var(--ink-raised);
    border: 1px solid var(--ink-line);
    border-radius: 3px;
    color: var(--bone);
    font-family: var(--data);
    font-size: 1rem;
  }

  .fam__lock-row input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .fam__lock-row .btn {
    padding-inline: 1.1rem;
  }

  .fam .btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .fam__lock-keep {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    color: var(--muted);
    cursor: pointer;
  }

  .fam__lock-keep input {
    accent-color: var(--accent);
  }

  .fam__lock-error {
    min-height: 1.5em;
    font-size: 0.92rem;
    color: var(--accent);
  }

  /* ── Toolbar ─────────────────────────────────────────────────────────── */

  .fam__bar {
    border-block: var(--rule);
    background: color-mix(in srgb, var(--ink) 90%, transparent);
    backdrop-filter: blur(8px);
  }

  @media (min-width: 40rem) {
    .fam__bar {
      position: sticky;
      top: 3rem;
      z-index: 4;
    }
  }

  .fam__bar-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.5rem;
  }

  .fam__tabs {
    display: flex;
    gap: 0.25rem;
    margin-left: -0.6rem;
  }

  .fam__tabs a {
    font-family: var(--data);
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    padding: 1rem 0.6rem 0.9rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }

  /* Four tabs fit a phone once the spacing tightens; on anything narrower they wrap. */
  @media (max-width: 30rem) {
    .fam__tabs {
      flex-wrap: wrap;
      gap: 0;
    }

    .fam__tabs a {
      padding-inline: 0.5rem;
      letter-spacing: 0.1em;
    }
  }

  .fam__tabs a:hover {
    color: var(--bone);
  }

  .fam__tabs a[aria-current='page'] {
    color: var(--bone);
    border-bottom-color: var(--accent);
  }

  .fam__search {
    position: relative;
    flex: 1 1 15rem;
    max-width: 24rem;
    margin-left: auto;
    padding-block: 0.5rem;
  }

  @media (max-width: 39.99rem) {
    .fam__search {
      max-width: none;
      margin-left: 0;
      padding-bottom: 0.85rem;
    }
  }

  .fam__search input {
    width: 100%;
    padding: 0.55rem 0.75rem;
    background: var(--ink-raised);
    border: 1px solid var(--ink-line);
    border-radius: 3px;
    color: var(--bone);
    font-family: var(--data);
    font-size: 0.875rem;
  }

  .fam__search input::placeholder {
    color: var(--muted);
  }

  .fam__search input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .fam__results {
    position: absolute;
    top: calc(100% - 0.15rem);
    left: 0;
    right: 0;
    z-index: 6;
    max-height: min(24rem, 60vh);
    overflow: auto;
    padding: 0.3rem !important;
    background: var(--ink-raised);
    border: 1px solid var(--ink-line);
    border-radius: 4px;
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.5);
  }

  .fam__results li {
    display: grid;
    gap: 0.1rem;
    padding: 0.5rem 0.65rem;
    border-radius: 3px;
    cursor: pointer;
  }

  .fam__results li[aria-selected='true'],
  .fam__results li:hover {
    background: var(--ink-line);
  }

  .fam__result-name {
    font-family: var(--display);
    font-weight: 600;
    line-height: 1.3;
  }

  .fam__result-meta,
  .fam__results .fam__result-none {
    font-family: var(--data);
    font-size: 0.75rem;
    color: var(--muted);
    cursor: default;
  }

  .fam__who {
    margin-top: 1.5rem;
  }

  .fam__who-ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .fam__who-ask[hidden],
  .fam__who-set[hidden] {
    display: none;
  }

  .fam .fam__search--who {
    flex: 0 1 17rem;
    margin-left: 0;
    padding-block: 0;
  }

  .fam__search--who .fam__results {
    top: calc(100% + 0.35rem);
  }

  .fam__who-hint {
    flex: 1 1 18rem;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .fam__who-set {
    font-family: var(--data);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .fam__who-set a {
    color: var(--second);
  }

  .fam .linkish {
    margin-left: 0.5rem;
    padding: 0;
    background: none;
    border: 0;
    color: var(--accent);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  .fam__view {
    padding-top: 1.75rem;
    min-height: 60vh;
    scroll-margin-top: 7.5rem;
  }

  .fam [data-focus-target]:focus {
    outline: none;
  }

  /* ── Map ─────────────────────────────────────────────────────────────── */

  .map {
    display: grid;
    gap: 1.25rem;
  }

  .map__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .fam button.chip {
    background: transparent;
    cursor: pointer;
  }

  .fam .chip[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--bone);
  }

  .map__body {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 60rem) {
    .map__body {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: start;
    }

    .map__panel {
      max-height: min(38rem, 70vh);
      overflow: auto;
      scrollbar-color: var(--ink-line) transparent;
      padding-right: 0.25rem;
    }
  }

  .map__canvas {
    height: min(38rem, 62vh);
    border: var(--rule);
    border-radius: 4px;
    /* Keeps the map's controls under the sticky toolbar. */
    isolation: isolate;
  }

  .map__panel {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .map__title {
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 650;
    line-height: 1.2;
  }

  .map__lede {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .map__back {
    justify-self: start;
    text-decoration: none;
  }

  .map__back::before {
    content: '← ';
  }

  .fam .map__list .lineitem {
    padding-block: 0.55rem;
  }

  .fam .maplibregl-ctrl-group {
    background: var(--ink-raised);
    border: 1px solid var(--ink-line);
    box-shadow: none;
  }

  .fam .maplibregl-ctrl-group button + button {
    border-top-color: var(--ink-line);
  }

  .fam .maplibregl-ctrl-group button:hover {
    background-color: var(--ink-line);
  }

  /* The +/− icons are dark SVGs; flip them for the dark buttons. */
  .fam .maplibregl-ctrl-icon {
    filter: invert(1) brightness(0.9);
  }

  .fam .maplibregl-ctrl.maplibregl-ctrl-attrib {
    background: rgb(22 23 25 / 0.85);
    color: var(--muted);
    font-size: 0.65rem;
  }

  .fam .maplibregl-ctrl-attrib a {
    color: var(--second);
  }

  .fam .maplibregl-ctrl-attrib-button {
    filter: invert(1);
  }

  .fam .maplibregl-cooperative-gesture-screen {
    font-family: var(--data);
    font-size: 0.85rem;
  }

  .fam .map__tip .maplibregl-popup-content {
    padding: 0.35rem 0.6rem;
    background: var(--ink-raised);
    color: var(--bone);
    border: 1px solid var(--ink-line);
    border-radius: 3px;
    box-shadow: none;
    font-family: var(--data);
    font-size: 0.72rem;
  }

  .fam .map__tip .maplibregl-popup-tip {
    border-top-color: var(--ink-line);
    border-bottom-color: var(--ink-line);
  }

  /* ── Shared pieces ───────────────────────────────────────────────────── */

  .fam .btn {
    display: inline-block;
    padding: 0.55rem 0.85rem;
    background: transparent;
    border: 1px solid var(--ink-line);
    border-radius: 3px;
    color: var(--bone);
    font-family: var(--data);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .fam .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .fam .chip {
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--ink-line);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--data);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .fam .chip:hover {
    border-color: var(--accent);
  }

  .fam .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14.5rem), 1fr));
    gap: 0.5rem;
  }

  .pcard {
    display: flex;
    gap: 0.75rem;
    height: 100%;
    padding: 0.7rem 0.85rem;
    background: var(--ink-raised);
    border: 1px solid var(--ink-line);
    border-radius: 4px;
    color: var(--bone);
    text-decoration: none;
    transition: border-color 160ms ease;
  }

  .pcard:hover {
    color: var(--bone);
    border-color: var(--accent);
  }

  .pcard:hover .pcard__name {
    color: var(--accent);
  }

  .pcard.is-direct {
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .pcard__num {
    padding-top: 0.15rem;
    font-family: var(--data);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .pcard__body {
    display: grid;
    align-content: start;
    gap: 0.1rem;
    min-width: 0;
  }

  .pcard__name {
    font-family: var(--display);
    font-weight: 600;
    line-height: 1.25;
    transition: color 160ms ease;
  }

  .pcard__meta {
    font-family: var(--data);
    font-size: 0.74rem;
    color: var(--muted);
  }

  .pcard__rel {
    font-size: 0.95rem;
    font-style: italic;
    line-height: 1.35;
    color: var(--second);
  }

  .fam .notes {
    display: grid;
    gap: 0.5rem;
  }

  .fam .notes li {
    padding-left: 0.9rem;
    border-left: 2px solid var(--ink-line);
    color: var(--second);
    max-width: var(--measure);
  }

  /* ── Explore ─────────────────────────────────────────────────────────── */

  .ex {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 60rem) {
    .ex {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }

  .ex__focus {
    display: grid;
    gap: 1.15rem;
    align-content: start;
    animation: rise 500ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .ex__rel {
    color: var(--accent);
  }

  .ex__name {
    margin-top: -0.4rem;
    font-size: var(--step-3);
    font-variation-settings: 'wdth' 104;
    font-weight: 700;
  }

  .ex__aka {
    margin-top: -0.4rem;
    font-style: italic;
    color: var(--second);
  }

  .facts {
    margin: 0;
    border-top: var(--rule);
  }

  .facts > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: var(--rule);
  }

  .facts dt {
    padding-top: 0.2rem;
  }

  .facts dd {
    margin: 0;
  }

  .facts__sub {
    display: block;
    color: var(--muted);
  }

  .route {
    display: grid;
    gap: 0.6rem;
  }

  .route__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0;
    font-family: var(--data);
    font-size: 0.76rem;
  }

  .route__stop {
    display: flex;
    align-items: center;
  }

  .route__stop + .route__stop::before {
    content: '›';
    margin-inline: 0.4rem;
    color: var(--muted);
  }

  .route__stop a {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--ink-line);
    border-radius: 999px;
    color: var(--second);
    text-decoration: none;
  }

  .route__stop a:hover {
    border-color: var(--accent);
  }

  .route__stop.is-apex a {
    border-color: var(--second);
    color: var(--bone);
  }

  .route__stop.is-start a,
  .route__stop.is-end a {
    border-color: var(--accent);
    color: var(--accent);
  }

  .route__and {
    margin-inline: 0.3rem;
    color: var(--muted);
  }

  .ex__lines,
  .ex__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ex__actions {
    padding-top: 0.25rem;
  }

  .ex__family {
    display: grid;
    gap: 2.25rem;
    animation: rise 500ms 80ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .fam .group {
    display: grid;
    gap: 0.75rem;
  }

  .union {
    display: grid;
    gap: 0.7rem;
  }

  .union + .union {
    padding-top: 1.25rem;
    border-top: var(--rule);
  }

  .union__meta {
    font-family: var(--data);
    font-size: 0.76rem;
    color: var(--muted);
  }

  .fam .cards--kids {
    padding-left: 1rem;
    border-left: 1px solid var(--ink-line);
  }

  /* ── Start ───────────────────────────────────────────────────────────── */

  .start {
    display: grid;
    gap: 2.5rem;
    animation: rise 500ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .start__head {
    display: grid;
    gap: 0.5rem;
  }

  .start__title {
    font-size: var(--step-2);
    font-variation-settings: 'wdth' 108;
    font-weight: 700;
  }

  .start__lede,
  .start__note {
    color: var(--second);
  }

  /* ── Ancestors ───────────────────────────────────────────────────────── */

  .anc__head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .anc__title,
  .outline__title {
    font-size: var(--step-2);
    font-variation-settings: 'wdth' 108;
    font-weight: 700;
  }

  .anc__lede,
  .outline__lede {
    color: var(--second);
  }

  .anc__scroll {
    overflow-x: auto;
    padding: 1.25rem;
